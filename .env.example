# ===== 轴承缺陷检测系统环境配置示例 =====
# 复制本文件为项目根目录 .env 后按需修改；所有项都有默认值，不配置也可运行。

# 数据库（PostgreSQL 便携版默认端口 5432，本地 trust 认证）
DETECT_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bearing_defect

# Redis 缓存
DETECT_REDIS_URL=redis://localhost:6379/0
DETECT_REDIS_ENABLED=true

# 模型路径（默认自动定位，一般无需修改）
# DETECT_YOLO_WEIGHTS=backend/weights/yolo_best.pt
# DETECT_SVM_CLASSIFIER=backend/artifacts/svm_classifier.joblib

# 检测默认阈值（GA 优化后由 svm_classifier.joblib 内置阈值覆盖）
# DETECT_DEFAULT_CONF_TH=0.25
# DETECT_DEFAULT_PROB_TH=0.5
